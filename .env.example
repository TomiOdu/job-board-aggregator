# Copy this file to `.env` and fill in your own keys.
# `.env` is gitignored - never commit real credentials.
# IMPORTANT: keep this file's values as placeholders. Edit `.env`, not this file.

# Adzuna: register at https://developer.adzuna.com/ -> gives you an App ID + App Key
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# Reed: register at https://www.reed.co.uk/developers -> gives you a single API key
REED_API_KEY=your_reed_api_key

# Optional: DEBUG for verbose logging
LOG_LEVEL=INFO
